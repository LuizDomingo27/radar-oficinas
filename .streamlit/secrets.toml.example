# Copie para .streamlit/secrets.toml (local) ou cole em Settings > Secrets no
# Streamlit Cloud. NUNCA comite o secrets.toml real (está no .gitignore).
# O token precisa de permissão de escrita no repositório (Contents: read/write).
[github]
token = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
repo = "seu-usuario/APP_PERFOR"
branch = "main"
