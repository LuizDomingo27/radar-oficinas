# Copie para .streamlit/secrets.toml (local) ou cole em Settings > Secrets no
# Streamlit Cloud. NUNCA comite o secrets.toml real (está no .gitignore).

# --- Radar de Oficinas: token do GitHub p/ persistir data/*.json ---
# O token precisa de permissão de escrita no repositório (Contents: read/write).
[github]
token = "COLE_SEU_TOKEN_AQUI"
repo = "LuizDomingo27/radar-oficinas"
branch = "main"

# --- Gestão de Postos: conexão Supabase (Postgres via PostgREST) ---
# Use a service_role key (ignora RLS). NUNCA coloque a chave real aqui — este
# arquivo .example é versionado. A chave real vai só no secrets.toml (ignorado).
[supabase]
url = "https://SEU_PROJETO.supabase.co"
service_role_key = "COLE_SUA_SERVICE_ROLE_KEY_AQUI"
